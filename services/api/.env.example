# Never commit actual secrets or health exports
SHIYI_ENV=local
SHIYI_RECOMMENDER=rules
# TYPESAFE_API_KEY=...
# LLM_API_KEY=...

# Local testing only: generate unique opaque tokens; never commit real values.
# Export these variables in the shell (the API does not auto-load .env).
# SHIYI_DEV_USERS={"alice":"<random token at least 16 characters>"}
SHIYI_DB_PATH=private_data/shiyi.sqlite3

# Simulator-only device identities; tokens must differ from user tokens.
# SHIYI_DEV_DEVICES={"sim":{"user_id":"alice","token":"<unique random device token>"}}
# SHIYI_SIM_DEVICE_ID=sim
# SHIYI_SIM_DEVICE_TOKEN=<same simulator token>
# MCP_ENDPOINT is secret: set only in shell, never in tracked configuration.

# Local-only optional model adapter (synthetic data; both user opt-in and server config required)
# SHIYI_RANKER=local_llm
# SHIYI_LOCAL_MODEL_URL=http://127.0.0.1:11434/v1/chat/completions
# SHIYI_LOCAL_MODEL_NAME=<installed-model>

# Opt in only for a controlled, authorized real-device test with protected transport/storage.
SHIYI_ENABLE_REAL_HEALTH=0
